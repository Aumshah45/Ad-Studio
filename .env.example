APP_ENV=dev
PROJECT_NAME=ad-studio
DATABASE_URL=postgresql+psycopg://localhost:5432/ad_studio
TEST_DATABASE_URL=postgresql+psycopg://localhost:5432/ad_studio_test
NEXT_PUBLIC_API_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000
LLM_PRIMARY=google:gemini-3.8-flash
LLM_FALLBACKS=groq:llama-3.3-70b-versatile
LLM_JUDGE=groq:openai/gpt-oss-120b
LLM_TIMEOUT_S=30
LLM_MAX_CONCURRENCY=3
IMAGE_MODEL_CANDIDATE=google:gemini-3.1-flash-lite-image
IMAGE_MODEL_REPAIR=google:gemini-3.1-flash-image
# TBC by the slice-1 spike: must be a vision (image-input) model; startup fails on a text-only one
VISION_JUDGE=google:gemini-3.8-flash
IMAGE_TIMEOUT_S=60
# gemini (needs GOOGLE_API_KEY) | fake (local composite of the product photo; no key, no network)
IMAGE_CLIENT=gemini
# gemini (VISION_JUDGE via the gateway; no key -> vision checks unverified -> needs_review)
# | fake (scripted favourable verdicts; key-less dev only, never for real results)
VISION_CLIENT=gemini
# interactions (primary) | generate_content (alternative adapter); confirmed by the slice-1 spike
IMAGE_API=interactions
# IMAGE_CLIENT=fake only: scripted failures for the offline demo. "label=b1,b2;label=b"; labels:
# candidate (or candidate.0 / candidate.1 per slot), regenerate, repair_product, repair_context,
# repair_text, clean_plate; behaviours: ok|typo|recolor|stray|blank|block, applied to that label's
# 1st, 2nd, ... call in a run (the last repeats). Demo: candidate=typo;repair_text=typo
FAKE_IMAGE_SCRIPT=
N_CANDIDATES=2
MAX_REPAIRS=2
# native headline edits before the deterministic overlay (0 = overlay straight away)
TEXT_REPAIR_ATTEMPTS=1
AD_BUDGET_USD=0.25
MAX_IMAGE_CALLS=5
DAILY_BUDGET_USD=3
AD_WALLCLOCK_S=150
RUNS_MAX_CONCURRENT=4
RUNS_QUEUE_CAP=20
PYDANTIC_AI_NO_BANNER=1
# Gemini key for live generation; leave it empty to run fully offline with the fake clients.
GOOGLE_API_KEY=
# Optional text-model fallback via Groq.
GROQ_API_KEY=
# Optional text-model fallback via OpenRouter.
OPENROUTER_API_KEY=
# Traces to Phoenix (:6006). `make dev` forces this off and `make dev-traces` forces it on.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006/v1/traces
RATE_LIMIT_PER_MIN=120
# Per-IP admission limits (429 problem+json + Retry-After); 0 = off, raise them for a demo
RUNS_PER_HOUR_PER_IP=10
RUNS_CONCURRENT_PER_IP=2
PRODUCTS_PER_HOUR_PER_IP=30
# Open text proxies /v1/llm/complete|stream: unset = on only when APP_ENV=dev (404 otherwise);
# true/false forces them on/off
# LLM_DEV_ROUTES=
MAX_BODY_BYTES=12582912
MAX_UPLOAD_BYTES=10485760
MAX_INPUT_CHARS=20000
